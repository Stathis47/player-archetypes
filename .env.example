   # Copy this file to .env and set the paths for your machine.
   GOALUNIT_DATA_DIR=path/to/your/data
   # Optional explicit override. If set, this takes precedence over GOALUNIT_DATA_DIR.
   GOALUNIT_EVENTS_PARQUET=path/to/events.parquet
   # Optional: raw CSV read by convert_events_csv_to_parquet.py (defaults to GOALUNIT_DATA_DIR/events.csv).
   GOALUNIT_EVENTS_CSV=path/to/events.csv